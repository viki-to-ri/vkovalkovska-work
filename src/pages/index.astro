---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CoverPreload from "../components/CoverPreload.astro";
import { getProjects } from "../lib/projects";
import { COLUMN_SIZES, IMAGE_QUALITY, widthsFor } from "../lib/images";
import { AVAILABILITY } from "../lib/site";

const projects = await getProjects();
---

<Base page="home">
	<p class="availability">{AVAILABILITY}</p>

	<div class="prose">
		<p data-hero-bio>
			Hi, I’m Viki, a product designer with an engineering background. I like figuring out how things
			work and turning that into simple, enjoyable products.<br /><br />Since 2017, I’ve worked on native mobile apps and websites, from
			0→1 discovery to product-led growth, mostly with remote, international teams.
		</p>
	</div>

	{/* Tabs over one card. The id is where a case page's "← back" lands. */}
	<section class="section work" id="selected-work" data-selected-work-section>
		<div class="sw" data-sw>
			<div class="sw-head">
				<h2 class="label">Selected work</h2>
				<div class="sw-tabs" role="tablist" aria-label="Selected work">
					{
						projects.map((project, index) => (
							<button
								type="button"
								role="tab"
								class="sw-tab"
								data-sw-tab={project.id}
								aria-selected={index === 0 ? "true" : "false"}
								aria-controls="sw-card"
							>
								{project.data.tab ?? project.data.title.toLowerCase()}
							</button>
						))
					}
				</div>
			</div>

			<a
				class="sw-card"
				id="sw-card"
				href={`/work/${projects[0].id}`}
				aria-label={`${projects[0].data.title} case study`}
				data-sw-card
			>
				{/* Every cover is in the markup, stacked; the active one fades in. */}
				<div class="sw-cover">
					{
						projects.map((project, index) =>
							project.data.cover ? (
								<Image
									src={project.data.cover}
									alt={project.data.coverAlt ?? ""}
									widths={widthsFor(project.data.cover)}
									quality={IMAGE_QUALITY}
									sizes={COLUMN_SIZES}
									loading={index === 0 ? "eager" : "lazy"}
									decoding="async"
									class:list={{ "is-active": index === 0 }}
									data-sw-panel={project.id}
								/>
							) : (
								<span class:list={{ "is-active": index === 0 }} data-sw-panel={project.id} />
							),
						)
					}
				</div>

				{/* All four share one grid cell, so the card is as tall as the longest
				   overview and nothing below it moves when the project changes. */}
				<div class="sw-metas">
					{
						projects.map((project, index) => (
							<div class:list={["sw-meta", { "is-active": index === 0 }]} data-sw-panel={project.id}>
								<div class="sw-head-line">
									<span class="sw-name">{project.data.title}</span>
									<span class="sw-tag">{project.data.tag}</span>
								</div>
								<span class="sw-years">{project.data.years}</span>
								<p class="sw-overview">{project.data.description}</p>
								<span class="sw-cta">
									read case study <span>→</span>
								</span>
							</div>
						))
					}
				</div>
			</a>
		</div>
	</section>

	<CoverPreload />
</Base>

<script>
	/* Selected work: tabs over one card, cycling on its own.

	   - A tab selects its project; the card's covers crossfade and its meta swaps.
	   - Auto-cycle: 4s idle, then a step every 4s, wrapping. Hover or focus anywhere
	     in the block pauses it; leaving restarts the idle wait. The first tab click
	     stops it for the rest of the page's life.
	   - A tick is skipped unless the page is visible, more than 240px of the block
	     is on screen (pixels, not an IntersectionObserver ratio — the block is
	     taller than a short laptop screen, so a ratio never fires), motion isn't
	     reduced and the device can hover — no cycling on phones and tablets.
	   - `?work=<id>` (the case pages' "← back") opens on that project without
	     counting as a click. */
	const root = document.querySelector<HTMLElement>("[data-sw]");
	const card = document.querySelector<HTMLAnchorElement>("[data-sw-card]");

	if (root && card) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-sw-tab]")];
		const ids = tabs.map((tab) => tab.dataset.swTab!);
		const panels = [...root.querySelectorAll<HTMLElement>("[data-sw-panel]")];
		const names = new Map(
			[...root.querySelectorAll<HTMLElement>(".sw-meta")].map((meta) => [
				meta.dataset.swPanel!,
				meta.querySelector(".sw-name")!.textContent!,
			]),
		);
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const noHover = window.matchMedia("(hover: none)");
		const STEP = 4000;
		let index = 0;
		let stopped = false;
		let idle = 0;
		let interval = 0;

		function select(to: number) {
			index = to;
			const id = ids[index];
			tabs.forEach((tab, i) => tab.setAttribute("aria-selected", String(i === index)));
			panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.swPanel === id));
			card!.href = `/work/${id}`;
			card!.setAttribute("aria-label", `${names.get(id)} case study`);
		}

		function canStep() {
			if (document.visibilityState !== "visible") return false;
			if (reduceMotion.matches || noHover.matches) return false;
			const rect = root!.getBoundingClientRect();
			return Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0) > 240;
		}

		function pause() {
			window.clearTimeout(idle);
			window.clearInterval(interval);
		}

		function resume() {
			pause();
			if (stopped) return;
			idle = window.setTimeout(() => {
				interval = window.setInterval(() => {
					if (canStep()) select((index + 1) % ids.length);
				}, STEP);
			}, STEP);
		}

		tabs.forEach((tab, i) =>
			tab.addEventListener("click", () => {
				stopped = true;
				pause();
				select(i);
			}),
		);

		/* Paused while either the pointer or focus is inside; resumes when both
		   have left. Focus moving from tab to tab never counts as leaving. */
		let hovered = false;
		root.addEventListener("mouseenter", () => {
			hovered = true;
			pause();
		});
		root.addEventListener("mouseleave", () => {
			hovered = false;
			if (!root.contains(document.activeElement)) resume();
		});
		root.addEventListener("focusin", pause);
		root.addEventListener("focusout", (event) => {
			if (!hovered && !root.contains(event.relatedTarget as Node | null)) resume();
		});
		window.addEventListener("pagehide", pause);
		window.addEventListener("pageshow", (event) => {
			if (event.persisted) resume();
		});

		select(Math.max(0, ids.indexOf(new URLSearchParams(location.search).get("work") ?? "")));
		resume();
	}
</script>
