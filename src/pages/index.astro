---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WorkIndex from "../components/WorkIndex.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects();
---

<Base revealFooter>
	<SiteHeader home reveal />

	<main id="main">
		<section class="intro reveal">
			<h1>Hi! I am Viki, a product designer with engineering background and visual sensibility.</h1>
			<p>
				Generalist problem solver, for 6+ years I design products which work for users and the
				business. Off the screen: contemplative practice, yoga, contact improvisation.
			</p>
		</section>

		<WorkIndex projects={projects} />
	</main>
</Base>

<style>
	.intro {
		padding: 56px var(--gutter) 0;
		animation-delay: 60ms;
	}

	.intro h1 {
		max-width: 15em;
		font-size: clamp(24px, 3.4vw, 34px);
		font-weight: 300;
		line-height: 1.3;
		text-wrap: pretty;
	}

	.intro p {
		max-width: 30em;
		margin-top: 14px;
		font-size: 14px;
		color: var(--ink-60);
		text-wrap: pretty;
	}
</style>
