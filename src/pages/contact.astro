---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with Viki Kovalkovska" />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.contact-links {
				list-style: none;
				margin: 1.5em 0 0 0;
				padding: 0;
			}
			.contact-links li {
				margin-bottom: 0.75em;
				font-size: 1.1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Get in touch</h1>
			<p>Have a project in mind, or just want to say hi? I'd love to hear from you.</p>
			<ul class="contact-links">
				<li>Email: <a href="mailto:viki.kovalkovska@gmail.com">viki.kovalkovska@gmail.com</a></li>
				<li>
					LinkedIn: <a href="https://www.linkedin.com/in/viki-kovalkovska/" target="_blank" rel="noopener noreferrer"
						>linkedin.com/in/viki-kovalkovska</a
					>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
