---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Base title="Not found" description="That page does not exist.">
	<SiteHeader />

	<main id="main">
		<div class="block">
			<p class="label kicker">404</p>
			<h1>That page does not exist.</h1>
			<p class="back"><a href="/">← Back to work</a></p>
		</div>
	</main>
</Base>

<style>
	.block {
		padding: 64px var(--gutter) 96px;
		max-width: var(--measure);
	}

	.kicker {
		color: var(--blue);
	}

	h1 {
		margin-top: 14px;
		font-size: clamp(28px, 4.4vw, 40px);
		font-weight: 300;
		line-height: 1.15;
	}

	.back {
		margin-top: 24px;
		font-size: 14px;
	}

	.back a {
		color: var(--blue);
		text-decoration: none;
		border-bottom: 2px solid var(--blue);
		padding-bottom: 1px;
	}
</style>
