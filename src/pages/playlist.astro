---
import Base from "../layouts/Base.astro";
import { books, goodreadsSearch, PLAYLIST_UPDATED } from "../data/playlist";
---

<Base contact title="Playlist" description="Books I've read recently.">
	<h1 class="page-title">Playlist</h1>
	<p class="subhead">Books I've read recently.</p>

	<section class="section">
		<div class="rows">
			{
				books.map((book, i) => (
					<a
						class="row row--flat"
						href={goodreadsSearch(book.title, book.author)}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="row-num">{String(i + 1).padStart(2, "0")}</span>
						<span class="row-title">{book.title}</span>
						<span class="row-author">{book.author}</span>
					</a>
				))
			}
		</div>
		<p class="note">{PLAYLIST_UPDATED}</p>
	</section>

</Base>
