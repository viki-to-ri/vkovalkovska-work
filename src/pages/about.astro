---
import Base from "../layouts/Base.astro";
import { previousWork } from "../data/previous-work";
---

<Base page="about" title="About" description="Engineer turned product designer, working on growth, native apps and 0→1 discovery.">
	<h1 class="page-title">About</h1>

	<div class="prose">
		<p>
			I’m a product designer with an engineering background and a soft spot for the details other
			people skip.
		</p>
		<p>
			Since 2017, I’ve worked remotely with international teams on native mobile apps, websites,
			product-led growth and 0→1 discovery. That range has made me a generalist who feels at home
			anywhere from early research to final polish.
		</p>
		<p>
			I do my best work in collaboration. I love designing with people, not just for them, and letting
			research guide product decisions.
		</p>
		<p>Outside of design, I read a lot, study German and explore movement arts.</p>
	</div>

	<section class="section">
		<span class="label">Previous work</span>
		<div class="ledger">
			{
				previousWork.map((item) => (
					<div class="ledger-row">
						<span class="ledger-years">{item.years}</span>
						<span class="ledger-name">{item.name}</span>
						<span class="ledger-role">{item.role}</span>
					</div>
				))
			}
		</div>
	</section>

</Base>
