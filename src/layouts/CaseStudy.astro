---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Frame from "../components/Frame.astro";
import { EMAIL } from "../lib/site";

interface Props {
	project: CollectionEntry<"projects">;
	next?: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const p = project.data;
---

<Base title={p.title} description={p.premise}>
	<a class="back chip" href="/">← work</a>

	<h1 class="case-title">{p.title}</h1>
	<p class="case-premise">{p.premise}</p>

	<p class="case-meta">
		{
			p.meta.map((item, i) => (
				<>
					{i > 0 && <span aria-hidden="true">·</span>}
					<span>{item}</span>
				</>
			))
		}
	</p>

	<Frame
		src={p.cover}
		alt={p.coverAlt}
		placeholder={p.coverPlaceholder}
		variant="cover"
		width={760}
	/>

	<section class="section">
		<span class="label">Overview</span>
		{
			p.metrics.length > 0 && (
				<div class="metrics">
					{p.metrics.map((metric) => (
						<div class="metric">
							<div class="metric-value">{metric.value}</div>
							<div class="metric-label">{metric.label}</div>
						</div>
					))}
				</div>
			)
		}
		<div class="prose"><p>{p.summary}</p></div>
	</section>

	<section class="section">
		<span class="label">The details</span>
		<div class="details">
			{
				p.details.map((section) => (
					<details>
						<summary>
							<span class="chev" aria-hidden="true">▸</span>
							<span>{section.label}</span>
						</summary>
						<div class="detail-body">
							{section.body && <p>{section.body}</p>}
							{section.bullets.length > 0 && (
								<ul>
									{section.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							)}
						</div>
					</details>
				))
			}
		</div>
	</section>

	{
		p.screens.length > 0 && (
			<section class="section">
				<span class="label">Selected screens</span>
				<div class="screens">
					{p.screens.map((screen) => (
						<figure>
							<Frame placeholder={screen.caption} variant="screen" width={372} />
							<figcaption class="screen-caption">{screen.caption}</figcaption>
						</figure>
					))}
				</div>
			</section>
		)
	}

	<nav class="case-footer" aria-label="Case study">
		<span>
			have questions? <a class="link" href={`mailto:${EMAIL}`}>get in touch</a>
		</span>
		<span class="case-footer-nav">
			{next && <a class="link" href={`/work/${next.id}`}>next: {next.data.title} →</a>}
			<a class="link" href="/">all work</a>
		</span>
	</nav>
</Base>
