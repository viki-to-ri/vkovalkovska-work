---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Frame from "../components/Frame.astro";
import Zoomable from "../components/Zoomable.astro";
import CoverPreload from "../components/CoverPreload.astro";
import { COLUMN_SIZES, COLUMN_WIDTHS, SPLIT_SIZES, SPLIT_WIDTHS } from "../lib/images";

interface Props {
	project: CollectionEntry<"projects">;
	next?: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const p = project.data;

/* Two "Selected screens" shapes: the real figure layout when the case has
   figures, the 4:3 placeholder grid when it only has captions. The sticky split
   is gated on its own — Verizon has figures but no full-page shot. */
const hasFigures = p.figures.length > 0;
const hasPageFigure = Boolean(p.pageFigure);

/* Every magnify trigger on the page, in document order: cover, page figure, then
   each figure's images. The lightbox steps through them in that same order, so
   it only draws its arrows when there is somewhere to step to. */
const galleryCount =
	(p.cover ? 1 : 0) +
	(hasPageFigure ? 1 : 0) +
	p.figures.reduce((count, figure) => count + figure.imgs.length, 0);

---

<Base page="case" title={p.title} description={p.premise}>
	{/* Home, with the slider already on this case and the Selected work heading at
	    the top of the viewport. The query is read by the slider script; the
	    fragment does the scrolling, natively. */}
	<a class="back chip" href={`/?work=${project.id}#selected-work`}>← back</a>

	<h1 class="case-title">{p.title}</h1>
	<p class="case-premise">{p.premise}</p>

	{/* Separated by the 26px gap alone — no interpuncts. */}
	<p class="case-meta">
		{p.meta.map((item) => <span>{item}</span>)}
	</p>

	{
		/* A real cover takes its case's ratio (5:3 by default); the placeholder
		   keeps the 16:9 hatch. */
		p.cover ? (
			<Zoomable
				class="cover-image"
				style={`--cover-ratio: ${p.coverRatio}`}
				src={p.cover}
				alt={p.coverAlt ?? ""}
				widths={COLUMN_WIDTHS}
				sizes={COLUMN_SIZES}
				eager
			/>
		) : (
			<Frame placeholder={p.coverPlaceholder} variant="cover" width={760} />
		)
	}

	<section class="section">
		<span class="label">Overview</span>
		{
			p.metrics.length > 0 && (
				<div class="metrics">
					{p.metrics.map((metric) => (
						<div class="metric">
							<div class="metric-value">{metric.value}</div>
							<div class="metric-label">{metric.label}</div>
						</div>
					))}
				</div>
			)
		}
		<div class="prose"><p>{p.summary}</p></div>
	</section>

	<section class="section">
		<span class="label">The details</span>
		<div class="details">
			{
				p.details.map((section) => (
					<details>
						<summary>
							<span class="chev" aria-hidden="true">▸</span>
							<span>{section.label}</span>
						</summary>
						<div class="detail-body">
							{section.body.map((paragraph) => (
								<>
									<p>{paragraph.text}</p>
									{paragraph.note && <p class="detail-note">→ {paragraph.note}</p>}
								</>
							))}
							{section.bullets.length > 0 && (
								<ul>
									{section.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							)}
						</div>
					</details>
				))
			}
		</div>
	</section>

	{
		hasFigures ? (
			<section class="section">
				<span class="label">Selected screens</span>

				{/* The caption stays pinned while the tall page shot scrolls past it.
				    pageFigure.title is carried in the data but deliberately unrendered. */}
				{p.pageFigure && (
					<div class="fig-split">
						<div class="fig-split-caption">
							<p>{p.pageFigure.caption}</p>
						</div>
						<figure>
							<Zoomable
								src={p.pageFigure.src}
								alt={p.pageFigure.alt}
								widths={SPLIT_WIDTHS}
								sizes={SPLIT_SIZES}
							/>
						</figure>
					</div>
				)}

				{/* Caption above the images, not below — moved on purpose. One kicker
				    per figure however many images sit under it. */}
				<div class="figures">
					{p.figures.map((figure) => (
						<figure>
							<figcaption>
								<span class="fig-kicker">{figure.kicker}</span>
								{figure.title && <span class="fig-title">{figure.title}</span>}
								{figure.caption && <span class="fig-caption">{figure.caption}</span>}
							</figcaption>
							<div class:list={["fig-images", { "fig-images--stacked": figure.stacked }]}>
								{figure.imgs.map((img) => (
									<Zoomable
										src={img.src}
										alt={img.alt}
										widths={COLUMN_WIDTHS}
										sizes={COLUMN_SIZES}
									/>
								))}
							</div>
						</figure>
					))}
				</div>
			</section>
		) : (
			p.screens.length > 0 && (
				<section class="section">
					<span class="label">Selected screens</span>
					{/* Exact copy — lowercase, with the "!". The label inside each frame is
					    the only caption; the second one underneath was dropped. */}
					<p class="screens-note">screens are to be added soon!</p>
					<div class="screens">
						{p.screens.map((screen) => (
							<Frame placeholder={screen.caption} variant="screen" width={372} />
						))}
					</div>
				</section>
			)
		)
	}

	<CoverPreload />

	{/* No rule above this, no "all work" link (← back covers that) and no
	    contact line (the global footer carries it). Only the project name and its
	    arrow are underlined, never the word "next:". */}
	{
		next && (
			<nav class="case-footer" aria-label="Case study">
				<div class="case-footer-inner">
					<span>
						next: <a class="link" href={`/work/${next.id}`}>{next.data.title} →</a>
					</span>
				</div>
			</nav>
		)
	}

	{/* The <img> is built in JS, so nothing here requests an empty src on load. */}
	{
		galleryCount > 0 && (
			<div
				class="lightbox"
				id="lightbox"
				role="dialog"
				aria-modal="true"
				aria-label="Magnified image"
				tabindex="-1"
				hidden
			>
				<div class="lightbox-inner" />
				{galleryCount > 1 && (
					<>
						<button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous image">
							←
						</button>
						<button type="button" class="lightbox-nav lightbox-next" aria-label="Next image">
							→
						</button>
					</>
				)}
				<p class="sr-only" aria-live="polite" />
			</div>
		)
	}
</Base>

<script>
	/* Click-to-magnify. One click opens (it was a double-click at first and was
	   changed on purpose); a click anywhere on the overlay or Escape closes.

	   The gallery is every trigger on the page in document order, and ←/→ (keys
	   or buttons) step through it, wrapping at both ends. Images swap instantly,
	   and the lightbox always shows `data-zoom`, the full-resolution original.

	   The keydown listener only exists while the lightbox is open, Tab stays
	   inside the dialog, and focus goes back to the trigger that opened it. */
	const overlay = document.getElementById("lightbox");
	const inner = overlay?.querySelector<HTMLElement>(".lightbox-inner");

	if (overlay && inner) {
		const triggers = [...document.querySelectorAll<HTMLElement>(".zoom")];
		const buttons = [...overlay.querySelectorAll<HTMLButtonElement>(".lightbox-nav")];
		const status = overlay.querySelector<HTMLElement>("[aria-live]");
		let current = -1;
		let opener: HTMLElement | null = null;

		const onKey = (event: KeyboardEvent) => {
			if (event.key === "Escape") close();
			else if (event.key === "ArrowRight") {
				event.preventDefault();
				step(1);
			} else if (event.key === "ArrowLeft") {
				event.preventDefault();
				step(-1);
			} else if (event.key === "Tab") {
				/* Cycle between the two buttons, or pin focus on the overlay when
				   there are none. */
				event.preventDefault();
				const at = buttons.indexOf(document.activeElement as HTMLButtonElement);
				const next = buttons[(at + (event.shiftKey ? -1 : 1) + buttons.length) % buttons.length];
				(next ?? overlay!).focus();
			}
		};

		function show(index: number) {
			const src = triggers[index]?.dataset.zoom;
			if (!src) return;

			const img = document.createElement("img");
			img.src = src;
			img.alt = "";
			inner!.replaceChildren(img);
			overlay!.scrollTop = 0; // the guide page is tall; don't land mid-scroll on the next image
			current = index;
			if (status && triggers.length > 1) {
				status.textContent = `Image ${index + 1} of ${triggers.length}`;
			}
		}

		function step(direction: number) {
			show((current + direction + triggers.length) % triggers.length);
		}

		function open(trigger: HTMLElement) {
			show(triggers.indexOf(trigger));
			if (current < 0) return;

			overlay!.hidden = false;
			opener = trigger;
			document.addEventListener("keydown", onKey);
			overlay!.focus();
		}

		function close() {
			overlay!.hidden = true;
			inner!.replaceChildren();
			if (status) status.textContent = "";
			current = -1;
			document.removeEventListener("keydown", onKey);
			opener?.focus();
			opener = null;
		}

		overlay.addEventListener("click", () => close());

		/* stopPropagation, or the overlay's own click handler closes the lightbox. */
		for (const button of buttons) {
			const direction = button.classList.contains("lightbox-prev") ? -1 : 1;
			button.addEventListener("click", (event) => {
				event.stopPropagation();
				step(direction);
			});
		}

		for (const trigger of triggers) {
			trigger.addEventListener("click", () => open(trigger));
			trigger.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					open(trigger);
				}
			});
		}
	}
</script>
