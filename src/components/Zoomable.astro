---
import { Image } from "astro:assets";
import { IMAGE_QUALITY, widthsFor } from "../lib/images";

interface Props {
	src: ImageMetadata;
	alt: string;
	/** Emitted srcset widths, largest last. Capped at the source width. */
	widths: number[];
	sizes: string;
	/** Only the cover is above the fold; every figure below it lazy-loads. The
	    eager cover also decodes synchronously — async decoding left a blank frame
	    when switching between cases. */
	eager?: boolean;
	class?: string;
	style?: string;
}

const { src, alt, widths, sizes, eager = false, class: className, style } = Astro.props;

/* Animated GIFs must not go through sharp — it flattens them to a single frame.
   The import is already the optimised asset, so pass the original through. */
const animated = src.format === "gif";

/* `data-zoom` is the full-resolution original, which is what the lightbox shows
   at up to 1400px wide. The trigger is a div, so it needs the button role,
   tab stop and Enter/Space handling the handoff asks for. */
---

<div
	class:list={["zoom", className]}
	style={style}
	data-zoom={src.src}
	role="button"
	tabindex="0"
	title="Click to magnify"
>
	{
		animated ? (
			<img
				src={src.src}
				alt={alt}
				width={src.width}
				height={src.height}
				loading={eager ? "eager" : "lazy"}
				decoding={eager ? "sync" : "async"}
			/>
		) : (
			<Image
				src={src}
				alt={alt}
				widths={widthsFor(src, widths)}
				quality={IMAGE_QUALITY}
				sizes={sizes}
				loading={eager ? "eager" : "lazy"}
				fetchpriority={eager ? "high" : "auto"}
				decoding={eager ? "sync" : "async"}
			/>
		)
	}
</div>
