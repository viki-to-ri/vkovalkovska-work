---
import type { CollectionEntry } from "astro:content";
import WorkRow from "./WorkRow.astro";

interface Props {
	projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const count = String(projects.length).padStart(2, "0");
---

<section class="work" aria-labelledby="work-heading">
	<div class="section-label reveal">
		<h2 class="label" id="work-heading">Selected work</h2>
		<span class="num" aria-hidden="true">{count}</span>
	</div>

	<ul class="rows">
		{
			projects.map((project) => (
				<li>
					<WorkRow project={project} />
				</li>
			))
		}
	</ul>
</section>

<style>
	.section-label {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 30px var(--gutter) 12px;
		color: var(--ink-label);
		animation-delay: 100ms;
	}

	.section-label h2 {
		color: inherit;
	}

	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
		/* Each row draws its own top rule; the footer's top rule closes the stack.
		   Adding a border-bottom here would stack two 2px rules into a 4px one. */
	}

	/* Page-load reveal, staggered 40ms apart. CSS-only, runs once. */
	.rows li {
		animation: reveal 0.4s var(--ease) both;
	}
	.rows li:nth-child(1) {
		animation-delay: 140ms;
	}
	.rows li:nth-child(2) {
		animation-delay: 180ms;
	}
	.rows li:nth-child(3) {
		animation-delay: 220ms;
	}
	.rows li:nth-child(4) {
		animation-delay: 260ms;
	}
	.rows li:nth-child(5) {
		animation-delay: 300ms;
	}
	.rows li:nth-child(6) {
		animation-delay: 340ms;
	}
	.rows li:nth-child(n + 7) {
		animation-delay: 380ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.rows li {
			animation: none;
		}
	}
</style>
