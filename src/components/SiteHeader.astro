---
import { SITE_TITLE } from "../lib/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

/* No "work" link — it was removed. The name goes to the top of home, and each
   case's "← back" returns to its own card in the Selected work slider. */
const nav = [
	{ label: "about", href: "/about", current: path === "/about" },
	{ label: "playlist", href: "/playlist", current: path === "/playlist" },
];
---

<header class="site-header">
	<a class="site-name" href="/">{SITE_TITLE}</a>

	<nav class="site-nav" aria-label="Primary">
		{
			nav.map((item) => (
				<a class="chip" href={item.href} aria-current={item.current ? "page" : undefined}>
					{item.label}
				</a>
			))
		}

		{/* Shows the mode you will get, not the mode you are in. */}
		<button
			class="mode-toggle"
			type="button"
			data-mode-toggle
			aria-label="Switch to night mode"
			title="Switch to night mode"
		>
			<svg data-icon="moon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path
					d="M13.2 10.35A5.6 5.6 0 0 1 6.05 3.2a5.6 5.6 0 1 0 7.15 7.15z"
					stroke="currentColor"
					stroke-width="1.2"
					stroke-linejoin="round"></path>
			</svg>
			<svg data-icon="sun" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<circle cx="8" cy="8" r="5.3" stroke="currentColor" stroke-width="1.2"></circle>
				<circle cx="8" cy="8" r="2" fill="currentColor"></circle>
			</svg>
		</button>
	</nav>
</header>

<script>
	const KEY = "vk-portfolio-mode";
	const DAY = "blue-day";
	const NIGHT = "cool-night";

	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>("[data-mode-toggle]");

	/** The button names its destination, never its current state. */
	function describe(mode: string) {
		const label = mode === NIGHT ? "Switch to day mode" : "Switch to night mode";
		button?.setAttribute("aria-label", label);
		button?.setAttribute("title", label);
	}

	describe(root.dataset.mode ?? DAY);

	button?.addEventListener("click", () => {
		const next = root.dataset.mode === NIGHT ? DAY : NIGHT;
		root.dataset.mode = next;
		describe(next);
		try {
			localStorage.setItem(KEY, next);
		} catch {
			// Private browsing or blocked storage — the mode just won't persist.
		}
	});
</script>
