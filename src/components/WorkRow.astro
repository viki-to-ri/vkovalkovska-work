---
interface Props {
	index: number;
	title: string;
	tag: string;
	description: string;
	years: string;
	href: string;
}

const { index, title, tag, description, years, href } = Astro.props;
const number = String(index).padStart(2, "0");
---

<a class="row" href={href}>
	<span class="row-num">{number}</span>
	<span class="row-main">
		<span class="row-head">
			<span class="row-title">{title}</span>
			<span class="row-tag">{tag}</span>
		</span>
		<span class="row-desc">{description}</span>
	</span>
	<span class="row-year">{years}</span>
</a>
