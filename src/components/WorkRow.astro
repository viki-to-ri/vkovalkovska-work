---
interface Props {
	title: string;
	tag: string;
	description: string;
	years: string;
	href: string;
}

const { title, tag, description, years, href } = Astro.props;
---

<a class="row--work" href={href}>
	<span class="row-year">{years}</span>
	<span class="row-main">
		<span class="row-head">
			<span class="row-title">{title}</span>
			<span class="row-tag">{tag}</span>
		</span>
		<span class="row-desc">{description}</span>
	</span>
	{/* U+2794, not →. */}
	<span class="row-arrow" aria-hidden="true">➔</span>
</a>
