---
import { inlineMarkdown } from "../lib/inline";

interface Props {
	label: string;
	body: string;
	highlight?: boolean;
	/** Rendered inline at the end of the body — used on the OUTCOME field. */
	links?: { label: string; href: string }[];
}

const { label, body, highlight = false, links = [] } = Astro.props;
const html = inlineMarkdown(body);
---

<div class:list={["ledger", highlight && "is-highlight"]}>
	<div class="ledger-label">{label}</div>
	<div class="ledger-body">
		<p set:html={html} />
		{
			links.length > 0 && (
				<p class="links">
					{links.map((link, i) => (
						<>
							{i > 0 && <span aria-hidden="true"> · </span>}
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								{link.label}
							</a>
						</>
					))}
				</p>
			)
		}
	</div>
</div>

<style>
	.ledger {
		display: grid;
		grid-template-columns: 130px 1fr;
		gap: 24px;
		padding: 22px var(--gutter);
	}

	.ledger + .ledger {
		border-top: var(--rule-hair);
	}

	/* The one lilac field on the page. */
	.is-highlight {
		background: var(--lilac);
		border-top: var(--rule) !important;
	}

	.is-highlight .ledger-label {
		color: var(--blue-on-lilac);
	}

	.ledger-label {
		font-family: var(--font-mono);
		font-size: 10.5px;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.5;
		color: var(--blue);
	}

	.ledger-body {
		font-size: 14.5px;
		font-weight: 300;
		line-height: 1.6;
		color: var(--ink);
		max-width: var(--measure);
	}

	.links {
		margin-top: 10px;
	}

	@media (max-width: 720px) {
		.ledger {
			grid-template-columns: 1fr;
			gap: 10px;
		}
	}
</style>
